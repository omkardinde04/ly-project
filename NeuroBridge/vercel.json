{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "bindings": [
        {
          "type": "service",
          "service": "mlmodel",
          "format": "url",
          "env": "ML_SERVICE_URL"
        },
        {
          "type": "service",
          "service": "rag_brain",
          "format": "url",
          "env": "RAG_BRAIN_URL"
        }
      ]
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "mlmodel": {
      "root": "ml model",
      "framework": "flask",
      "entrypoint": "ml_service.py"
    },
    "rag_brain": {
      "root": "rag_brain",
      "framework": "fastapi",
      "entrypoint": "main.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}

